# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic — console.anthropic.com → API keys (Claude reads Street View photos and scores the pitch)
ANTHROPIC_API_KEY=

# OpenAI — platform.openai.com → API keys (Realtime voice copilot)
OPENAI_API_KEY=

# Google — console.cloud.google.com → Street View Static API key (photos of the curb)
GOOGLE_MAPS_API_KEY=

# Shared secret between the site and the Anbaric engine (same value as the engine's `engine-token` secret)
ENGINE_TOKEN=

# Supabase — not used by the demo
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
