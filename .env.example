# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic — console.anthropic.com → API keys (Claude: photo checks)
ANTHROPIC_API_KEY=

# OpenAI — platform.openai.com → API keys (Realtime voice)
OPENAI_API_KEY=

# Plan P engine (Anbaric app). Local: http://localhost:4000. Deployed: the app's Anbaric Cloud address.
ENGINE_URL=http://localhost:4000

# Supabase — supabase.com → your project → Project Settings → API (not used by the demo yet)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
