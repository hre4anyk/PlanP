# Copy to .env.local and fill in. Never commit .env.local.

# Clerk — dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Anthropic — console.anthropic.com → API keys (planner + voice intents)
ANTHROPIC_API_KEY=

# Google Gemini — aistudio.google.com → Get API key (sign reader)
GEMINI_API_KEY=

# OpenAI — platform.openai.com → API keys (speech to text + text to speech)
OPENAI_API_KEY=

# Supabase — supabase.com → your project → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
