# Copy to .env.local and fill in. Never commit .env.local.

# Clerk — dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OpenAI — platform.openai.com → API keys
OPENAI_API_KEY=

# Encrypts users' Stellar wallet secrets (32 random bytes, base64). Never change once wallets exist.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALLET_ENCRYPTION_KEY=

# Stellar testnet account that issues the ACDC token (fund it via friendbot.stellar.org)
ACDC_ISSUER_SECRET=

# Supabase — supabase.com → your project → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
